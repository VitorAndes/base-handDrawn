---
const { socialMediaIcon, socialMediaUrl, socialMediaAlt } = Astro.props;
---

<a
    href={socialMediaUrl}
    class="bg-background w-14 h-14 rounded-full shadow-[3px_3px_0px_rgba(12,12,0,100)] flex items-center justify-center transition-all duration-300 hover:translate-y-0.5 hover:inset-shadow-[-2px_-2px_0px_rgba(12,12,0,0.12)] hover:scale-105"
    target="_blank"
>
    <img src={socialMediaIcon.src} alt={socialMediaAlt} />
</a>
